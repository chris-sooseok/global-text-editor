{
  "name": "global-text-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron . --inspect=9229 --remote-debugging-port=9222",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "vite build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tiptap/core": "^3.16.0",
    "@tiptap/extension-highlight": "^3.16.0",
    "@tiptap/extension-image": "^3.16.0",
    "@tiptap/extension-link": "^3.16.0",
    "@tiptap/extension-list": "^3.16.0",
    "@tiptap/extension-subscript": "^3.16.0",
    "@tiptap/extension-superscript": "^3.16.0",
    "@tiptap/extension-text-align": "^3.16.0",
    "@tiptap/extension-text-style": "^3.16.0",
    "@tiptap/markdown": "^3.16.0",
    "@tiptap/pm": "^3.16.0",
    "@tiptap/react": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "better-sqlite3": "^12.5.0",
    "electron": "^39.2.7",
    "lodash.throttle": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hotkeys-hook": "^5.2.3",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sass-embedded": "^1.97.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}
