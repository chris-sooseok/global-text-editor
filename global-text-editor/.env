### SIDEBAR ###
# SidebarRenderer STATIC ENVS
VITE_DEFAULT_SIDEBAR_WIDTH=250
VITE_SIDEBAR_MIN_WIDTH=220
VITE_SIDEBAR_MAX_WIDTH=500
VITE_COLLAPSED_WIDTH=55
# SidebarRenderer localStorage Keys
VITE_SIDEBAR_WIDTH=sidebarWidth
VITE_SIDEBAR_COLLAPSED=sidebarCollapsed
# Sidebar localStorage Keys
VITE_SELECTED_NODE_KEY=selectedNode
VITE_SELECTED_FILE_KEY=selectedFile
VITE_SELECTED_FOLDER_KEY=selectedFolder
VITE_TOGGLED_FOLDERS_KEY=toggledFolderIds

### TABS ###
# Tab localStorage Keys
VITE_ACTIVE_TAB_ID=activeTabId # where to insert a file
VITE_TABS_IDS=tabIds # trace of tabs
VITE_ACTIVE_FILE_ID_BY_TAB_IDS=activeFileIdByTabIds # active file
VITE_FILES_BY_TABS_IDS=filesByTabIds # trace of files in each tab
VITE_TAB_IS_VISIBLE=tabIsVisible


### STYLES ###
# Sidebar and Tab
VITE_FILE_FONT_SIZE=16px

# Tab
VITE_ACTIVE_FILE_UNDER_ACTIVE_TAB_BACKGROUND=rgba(131, 125, 220, 0.15)
VITE_ACTIVE_FILE_BORDER=2px solid rgba(189, 184, 184, 0.15)
VITE_ACTIVE_FILE_BACKGROUND=rgba(211, 171, 171, 0.06)

# Normal Editor
VITE_EDITOR_DEFAULT_THEME=black
VITE_EDITOR_BACKGROUND_BLACK=rgb(0, 0, 0)
VITE_EDITOR_BACKGROUND_WHITE=rgb(241, 241, 241)
VITE_TOOLBAR_BACKGROUND_BLACK=rgb(0, 0, 0)
VITE_TOOLBAR_BACKGROUND_WHITE=rgb(241, 241, 241)

# DropdownOveraly 
VITE_DROPDOWN_BORDER_WHITE=1px solid rgb(50, 50, 50)
VITE_DROPDOWN_BACKGROUND_WHITE=rgba(255, 255, 255, 0.9)
VITE_DROPDOWN_COLOR_WHITE=rgb(0, 0, 0)
VITE_DROPDOWN_HIGHLIGHT=rgba(219, 219, 219, 0.87)
VITE_DROPDOWN_BORDER_BLACK=
VITE_DROPDOWN_BACKGROUND_BLACK=
VITE_DROPDOWN_COLOR_BLACK=





